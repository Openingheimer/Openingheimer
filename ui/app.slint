import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Chessboard } from "chessboard.slint";
import { MoveText } from "movetext.slint";
import { SanMove, SanMoveRow, PgnItem } from "model.slint";
import { PgnImport } from "pgnimport.slint";
import { PgnLoad } from "pgnload.slint";

export global Callbacks {
    pure callback piece_from_fen(string, int) -> string;
    pure callback make_move(string, string, string) -> bool;
    pure callback color_on_square(string, string) -> string;
    pure callback go_to_position(SanMove);
    pure callback go_to_move(int);
    pure callback import_pgn(string);
    pure callback choose_pgn();
}

export component AppWindow inherits Window {
    title: "Openingheimer";
    full-screen: is_full_screen;
    forward-focus: scope;

    in-out property <string> fen;
    in-out property <string> player_color;
    in-out property <[SanMoveRow]> move_rows;
    in-out property <bool> is_full_screen: false;
    in-out property <SanMove> current_move;
    in-out property <string> last_move_from;
    in-out property <string> last_move_to;
    in-out property <int> last_move_in_variation;
    in-out property <[PgnItem]> openings;

    public function scroll-to-index-y(index: int) {
        move_text.scroll_to_index_y(index);
    }

    public function scroll_to_index_x(index: int) {
        move_text.scroll_to_index_x(index);
    }

    public function close_import() {
        popup_import.close()
    }

    public function close_load() {
        popup_load.close()
    }

    public function clear_active_coords() {
        chessboard.clear_active_coords()
    }

    HorizontalBox {
        alignment: center;
        padding-top: 150px;

        chessboard := Chessboard {
            fen: root.fen;
            player_color: root.player_color;
            last_move_from: root.last_move_from;
            last_move_to: root.last_move_to;
            piece_from_fen(f, i) => Callbacks.piece_from_fen(f, i);
            make_move(fen, start_square, end_square) => Callbacks.make_move(fen, start_square, end_square);
            color_on_square(f, square) => Callbacks.color_on_square(f, square);
        }

        move_text := MoveText {
            move_rows: root.move_rows;
            current_move: root.current_move;
            go_to_position(m) => Callbacks.go_to_position(m);
            go_to_move(i) => Callbacks.go_to_move(i);
        }

        popup_import := PgnImport {
            import_pgn(pgn) => Callbacks.import_pgn(pgn);
            close_import => close_import();
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        popup_load := PgnLoad {
            load_pgn(pgn) => Callbacks.import_pgn(pgn);
            close_load() => close_load();
            openings: root.openings;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    scope := FocusScope {
        KeyBinding {
            keys: @keys(C);
            activated => popup_import.show();
        }

        KeyBinding {
            keys: @keys(Q);
            activated => {
                Callbacks.choose_pgn();
                popup_load.show();
            }
        }

        KeyBinding {
            keys: @keys(F);
            activated => {
                chessboard.board_flip = -chessboard.board_flip;
            }
        }

        KeyBinding {
            keys: @keys(RightArrow);
            activated => {
                Callbacks.go_to_move(current_move.next_id);
            }
        }

        KeyBinding {
            keys: @keys(LeftArrow);
            activated => {
                Callbacks.go_to_move(current_move.previous_id);
            }
        }
    }
}
