import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Chessboard } from "chessboard.slint";
import { Moves, MoveText } from "movetext.slint";

export global Callbacks {
    pure callback piece_from_fen(string, int) -> string;
    pure callback make_move(string, string, string) -> bool;
    pure callback color_on_square(string, string) -> string;
    pure callback check_legal_move(string) -> bool;
    pure callback refresh_legal_moves(string, string, bool);
}

export component AppWindow inherits Window {
    title: "Openingheimer";
    full-screen: is_full_screen;

    in-out property <string> fen:"rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
    in-out property <string> player_color;
    in-out property <[Moves]> move_list;
    in-out property <[string]> legal_moves;
    in-out property <bool> is_full_screen: false;

    HorizontalBox {
        alignment: center;
        padding-top: 150px;

        Chessboard {
            fen: root.fen;
            player_color: root.player_color;
            legal_moves: root.legal_moves;
            piece_from_fen(f, i) => Callbacks.piece_from_fen(f, i);
            make_move(fen, start_square, end_square) => Callbacks.make_move(fen, start_square, end_square);
            color_on_square(f, square) => Callbacks.color_on_square(f, square);
            check_legal_move(square) => Callbacks.check_legal_move(square);
            refresh_legal_moves(fen, square, clear) => Callbacks.refresh_legal_moves(fen, square, clear);
        }

        MoveText {
            move_list: root.move_list;
        }
    }
}
