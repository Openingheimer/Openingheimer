
import {
    ListView,
    VerticalBox,
    HorizontalBox,
    ScrollView,
} from "std-widgets.slint";

export struct Moves { white: string, black: string }

export component MoveText {
    width: 400px;
    height: 400px;

    property <length> font_size: 16px;
    property <color> light: #454441;
    property <color> dark: #41403D;

    in property <[Moves]> move_list;

    Rectangle {
        background: #41403D;

        scroll := ScrollView {
            viewport-y: scroll.height - scroll.viewport-height;

            VerticalLayout {

                for move[i] in move_list: HorizontalLayout {

                    property <color> bg: mod(i, 2) == 0 ? dark : light;

                    height: 40px;
                    Rectangle {
                        width: 60px;
                        background: bg;
                        Text {
                            x: 10px;
                            text: i + 1 + ".";
                            font-size: font_size;
                        }
                    }

                    Rectangle {
                        background: bg;
                        Text {
                            width: 100%;
                            text: move.white;
                            font-size: font_size;
                        }
                    }

                    Rectangle {
                        background: bg;
                        Text {
                            width: 100%;
                            text: move.black;
                            font-size: font_size;
                        }
                    }
                }
            }
        }
    }
}
