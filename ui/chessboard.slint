
export component Chessboard {

    width: boardpx;
    height: boardpx;

    in-out property <bool> boardFlipped: false;

    property <int> BOARD_SIZE: 600;

    property <length> boardpx: BOARD_SIZE * 1px;
    property <length> cellSize: (boardpx / 8);
    property <[string]> files: ["a", "b", "c", "d", "e", "f", "g", "h"];
    property <[string]> ranks: ["8", "7", "6", "5", "4", "3", "2", "1"];
    property <color> light: #EDD6B0;
    property <color> dark: #B88762;
    property <color> hightlight : #ffff33;

    property <string> fen: "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
    property <bool> is_grabbing_piece;
    property <bool> has_piece_selected;
    property <string> piece_selected;
    property <string> square_selected;
    property <string> destination_square;
    property<string> debug_info;

    pure callback piece_from_fen(string, int) -> string;

    VerticalLayout {

        Text {
            text: "Action: \{root.debug_info}";
            font-size: 24px;
        }

        board := GridLayout {

            for rank[r] in ranks: Row {
                for file[f] in files: Rectangle{

                    property <string> square: file + rank;
                    property <color> square_color : mod(f + r, 2) == 0 ? light : dark;

                    width: cellSize;
                    height: cellSize;
                    background: square == root.square_selected
                             ? square_color.mix(hightlight, 0.5)
                             : square_color;

                    TouchArea {
                        moved => {
                            destination_square = get_hovered_square(self.mouse-x, self.mouse-y, f, r);

                            grab_piece(squareImage.source, self.mouse-x, self.mouse-y, f, r)
                        }
                        pointer-event(event) =>
                            handle_event(event, square, squareImage.pieceName, squareImage.source,
                                         self.mouse-x, self.mouse-y, f, r);

                    }

                    squareImage := Image {
                        in-out property <string> pieceName: piece_from_fen(fen, f + (r * 8));
                        width: cellSize;
                        height: cellSize;
                        source: get_image(pieceName);
                        visible: square != root.square_selected || (square == root.square_selected && !root.is_grabbing_piece);
                    }
                }
            }
        }

    }

    grabbed_piece := Image {
                        in-out property <string> piece;
                        width: cellSize;
                        height: cellSize;
                        visible: root.is_grabbing_piece;
                    }

    function handle_pointer_down(square: string, piece: string, image: image,
                                 mousex: length, mousey: length, file: int, rank: int) {

        if (moving_piece(rank)) {
            root.debug_info = "Move " + square_selected + " " + piece_selected + " to " + square;
        }
        else {
            root.debug_info = "Selected " + square + " " + piece;
        }

        square_selected = square;
        destination_square = square;
        piece_selected = piece;

        grab_piece(image, mousex, mousey, file, rank);
    }

    function handle_pointer_up(square: string, piece: string) {

        if (selecting_piece(square)) {
            square_selected = square;
            piece_selected = piece;
        }
        else if (releasing_grabbed_piece()) {
            root.has_piece_selected = false;
            root.debug_info = "Move " + square_selected + " " + piece + " to " + destination_square;
        }

        root.is_grabbing_piece = false;
    }

    function moving_piece(rank: int) -> bool {

        let friendly_piece = rank == 1 || rank == 2;

        root.has_piece_selected && !friendly_piece
    }

    function selecting_piece(square: string) -> bool {
        root.has_piece_selected && destination_square == square
    }

    function releasing_grabbed_piece() -> bool {
        root.has_piece_selected
    }

    function grab_piece(piece: image, mousex: length, mousey: length, file: int, rank: int) {

        root.has_piece_selected = true;
        root.is_grabbing_piece = true;
        grabbed_piece.source = piece;

        let board_coords = get_board_coords(mousex, mousey, file, rank);
        let imageOffset = cellSize / 2;

        let clamp_leeway_x = -imageOffset + board.x;
        let clamp_leeway_y = -imageOffset + board.y;

        grabbed_piece.x = clamp(board_coords.x - imageOffset + board.x, clamp_leeway_x, boardpx + clamp_leeway_x);
        grabbed_piece.y = clamp(board_coords.y - imageOffset + board.y, clamp_leeway_y, boardpx + clamp_leeway_y);
     }

     function get_hovered_square(mousex: length, mousey: length, file: int, rank: int) -> string{

        let board = get_board_coords(mousex, mousey, file, rank);

        let f = files[(board.x / (cellSize))];
        let r = ranks[(board.y / (cellSize))];

        f + r
     }

     function get_board_coords(x: length, y: length, f:int, r: int) -> Point {

        let bx = x + (f * cellSize);
        let by = y + (r * cellSize);

        { x: bx, y: by };
     }

     function get_image(piece: string) -> image {
        if (piece == "P") {return @image-url("wp.png");}
        if (piece == "N") {return @image-url("wn.png");}
        if (piece == "B") {return @image-url("wb.png");}
        if (piece == "R") {return @image-url("wr.png");}
        if (piece == "Q") {return @image-url("wq.png");}
        if (piece == "K") {return @image-url("wk.png");}
        if (piece == "p") {return @image-url("bp.png");}
        if (piece == "n") {return @image-url("bn.png");}
        if (piece == "b") {return @image-url("bb.png");}
        if (piece == "r") {return @image-url("br.png");}
        if (piece == "q") {return @image-url("bq.png");}
        if (piece == "k") {return @image-url("bk.png");}

        @image-url("void.svg");
    }

    function handle_event(event: PointerEvent, square: string, piece: string, image: image,
                          mousex: length, mousey: length, file: int, rank: int) {

        if (event.kind == PointerEventKind.down) {
            handle_pointer_down(square, piece, image, mousex, mousey, file, rank);
        }
        else if (event.kind == PointerEventKind.up) {
            handle_pointer_up(square, piece);
        }
    }
}